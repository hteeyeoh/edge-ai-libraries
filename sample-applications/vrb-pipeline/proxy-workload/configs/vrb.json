{
    "config": {
        "logging": {
            "C_LOG_LEVEL": "INFO",
            "PY_LOG_LEVEL": "INFO"
        },
        "pipelines": [
            {
                "name": "object_detection",
                "source": "gstreamer",
                "queue_maxsize": 50,
                "pipeline": "{auto_source} ! decodebin ! videoconvert ! queue ! videorate drop-only=true ! videoconvertscale ! video/x-raw,format=BGRA,framerate={parameters[frame]}/1,width={parameters[frame_width]},height={parameters[frame_height]} ! gvadetect name=detection labels-file=/home/pipeline-server/resources/videos/labels.txt ! gvatrack tracking-type={parameters[tracking_type]} ! tee name=split split. ! queue ! gvametaconvert format=json add-empty-results=false ! gvapython class=FrameSelector function=process module=/home/pipeline-server/gvapython/publisher/frame_selector.py name=frame_selector ! queue ! gvagenai name=captioning ! queue ! gvapython class=Normalize function=process module=/home/pipeline-server/gvapython/publisher/normalize.py name=normalize ! gvametaconvert format=json add-empty-results=false ! gvametapublish file-path=/tmp/test_captions.json file-format=json ! fakesink sync=false async=false split. ! queue ! videoconvertscale ! video/x-raw,format=NV12 ! appsink name=appsink sync=false async=false",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "frame": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 64,
                            "default": 10
                        },
                        "frame_width": {
                            "type": "integer",
                            "minimum": 160,
                            "maximum": 1920,
                            "default": 640
                        },
                        "frame_height": {
                            "type": "integer",
                            "minimum": 120,
                            "maximum": 1080,
                            "default": 480
                        },
                        "tracking_type": {
                            "type": "string",
                            "enum": [
                                "zero-term",
                                "zero-term-imageless",
                                "short-term-imageless"
                            ],
                            "default": "zero-term"
                        },
                        "frame-selector-properties": {
                            "element": {
                                "name": "frame_selector",
                                "property": "kwarg",
                                "format": "json"
                            },
                            "type": "object",
                            "properties": {
                                "interested": {
                                    "type": "array"
                                }
                            },
                            "default": {
                                "interested": []
                            }
                        },
                        "detection-properties": {
                            "element": {
                                "name": "detection",
                                "format": "element-properties"
                            }
                        },
                        "captioning-properties": {
                            "element": {
                                "name": "captioning",
                                "format": "element-properties"
                            }
                        }
                    }
                },
                "auto_start": false
            }
        ]
    }
}