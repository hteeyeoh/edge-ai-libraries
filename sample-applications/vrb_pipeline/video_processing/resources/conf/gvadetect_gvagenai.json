{
    "config": {
        "logging": {
            "C_LOG_LEVEL": "INFO",
            "PY_LOG_LEVEL": "INFO"
        },
        "pipelines": [
            {
                "name": "object_detection",
                "source": "gstreamer",
                "queue_maxsize": 50,
                "pipeline": "{auto_source} ! decodebin ! videorate ! videoconvertscale ! video/x-raw,framerate={parameters[frame]}/1,format=BGRx,width=[1,{parameters[frame_width]}],pixel-aspect-ratio=1/1 ! gvadetect name=detection pre-process-backend=ie ! gvatrack tracking-type={parameters[tracking_type]} ! gvagenai device=CPU model-path=\"/home/pipeline-server/models/phi-4-multimodal-instruct/INT4/\" prompt=\"Describe the object in the frame.\" generation-config=\"max_new_tokens=100\" ! gvametapublish file-path=/tmp/output.json ! fakesink",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "frame": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 64,
                            "default": 2
                        },
                        "frame_width": {
                            "type": "integer",
                            "minimum": 160,
                            "maximum": 800,
                            "default": 480
                        },
                        "tracking_type": {
                            "type": "string",
                            "enum": [
                                "zero-term",
                                "zero-term-imageless",
                                "short-term-imageless"
                            ],
                            "default": "zero-term"
                        },
                        "detection-properties": {
                            "element": {
                                "name": "detection",
                                "format": "element-properties"
                            }
                        }
                    }
                },
                "auto_start": false
            }
        ]
    }
}